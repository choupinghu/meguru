# --- Local development (required) ---------------------------------------------
# Pooled connection string for the Neon *dev branch*. Neon dashboard ->
# Branches -> dev -> Connection Details -> pooled. This is what the app uses
# locally, so experiments and reseeds never touch the live site.
DATABASE_URL=

# --- Migrating production (optional) -----------------------------------------
# Pooled connection string for the Neon *main/production* branch — the same
# value set in Vercel's environment variables.
#
# Only used by `npm run db:migrate:prod`, never by the app. Kept as a separate
# variable on purpose: reaching production by editing DATABASE_URL and
# forgetting to change it back would leave local development mutating live
# data, which is exactly what the branch split prevents.
PRODUCTION_DATABASE_URL=
